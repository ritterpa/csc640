# Copy to .env and fill in real values. Never commit .env.

# MySQL account for the API (needs SELECT and EXECUTE on InfrastructureLogging)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=InfrastructureLogging
DB_USER=infralog_api
DB_PASS=change-me

# Secret for signing JWTs (HS256). Use a long random value, e.g.:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds
JWT_TTL=3600

# true shows internal error messages in 500 responses (development only)
APP_DEBUG=false
